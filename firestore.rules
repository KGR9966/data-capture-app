rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hjælpefunktioner
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    // Aflæs brugerens rolle i et projekt ud fra ownerId, roles-kort og memberEmails.
    // Email-inviterede medlemmer uden specifik rolle får editor-rettigheder.
    function getProjectMemberRole(projectData) {
      return isAuthenticated()
             ? (getUserId() == projectData.ownerId
                ? "owner"
                : (getUserId() in projectData.roles
                   ? projectData.roles.get(getUserId(), null)
                   : (getUserEmail() != null
                      && getUserEmail() in projectData.memberEmails
                      ? "editor"
                      : null)))
             : null;
    }

    function hasAnyProjectRole(projectData, allowedRoles) {
      return getProjectMemberRole(projectData) in allowedRoles;
    }

    function projectDataById(projectId) {
      return projectId != null && exists(/databases/$(database)/documents/projects/$(projectId))
             ? get(/databases/$(database)/documents/projects/$(projectId)).data
             : null;
    }

    function hasProjectRoleById(projectId, allowedRoles) {
      return getProjectMemberRole(projectDataById(projectId)) in allowedRoles;
    }

    // Projekter
    match /projects/{projectId} {
      function projectData() {
        return resource.data;
      }

      allow read: if isAuthenticated()
                     && hasAnyProjectRole(projectData(), ["owner", "admin", "editor", "viewer"]);

      allow create: if isAuthenticated() && request.resource.data.ownerId == getUserId();

      allow update: if isAuthenticated()
                     && (resource.data.ownerId == getUserId()
                         || (getUserId() in resource.data.roles
                             && request.resource.data.roles.get(getUserId(), null) in ["owner", "admin"]));

      allow delete: if isAuthenticated() && resource.data.ownerId == getUserId();
    }

    // Projekt-medlemmer
    match /projects/{projectId}/members/{memberId} {
      // Bemærk: Brug getAfter() i stedet for get() her, fordi medlemsdokumentet
      // ofte oprettes i samme batched write som projekt-dokumentet. getAfter()
      // ser projektets tilstand efter batchen er anvendt, mens get() ser den
      // nuværende tilstand før batchen.
      function projectData() {
        return getAfter(/databases/$(database)/documents/projects/$(projectId)).data;
      }

      function isProjectOwnerOrAdmin() {
        return isAuthenticated()
               && (projectData().ownerId == getUserId()
                   || (getUserId() in projectData().roles
                       && projectData().roles.get(getUserId(), null) in ["owner", "admin"]));
      }

      allow read: if isAuthenticated()
                     && hasAnyProjectRole(projectData(), ["owner", "admin", "editor", "viewer"]);

      allow create: if isProjectOwnerOrAdmin()
                     && request.resource.data.keys().hasAll(["role"])
                     && request.resource.data.role in ["owner", "admin", "editor", "viewer"];

      allow update: if isProjectOwnerOrAdmin()
                     && request.resource.data.keys().hasAll(["role"])
                     && request.resource.data.role in ["owner", "admin", "editor", "viewer"];

      allow delete: if isProjectOwnerOrAdmin();
    }

    // Items under project
    match /projects/{projectId}/items/{itemId} {
      allow read: if isAuthenticated()
                     && hasProjectRoleById(projectId, ["owner", "admin", "editor", "viewer"]);

      allow create: if isAuthenticated()
                     && hasProjectRoleById(projectId, ["owner", "admin", "editor"])
                     && request.resource.data.keys().hasAll(["projectId", "createdBy"])
                     && request.resource.data.projectId == projectId;

      allow update: if isAuthenticated()
                     && (
                          hasProjectRoleById(projectId, ["owner", "admin"])
                          || (
                               hasProjectRoleById(projectId, ["editor"])
                               && (
                                    resource.data.createdBy == getUserId()
                                    || resource.data.assignedTo == getUserId()
                                  )
                             )
                        );

      allow delete: if isAuthenticated()
                     && (
                          hasProjectRoleById(projectId, ["owner", "admin"])
                          || (
                               hasProjectRoleById(projectId, ["editor"])
                               && resource.data.createdBy == getUserId()
                             )
                        );
    }

    // Checkpoints under items
    match /projects/{projectId}/items/{itemId}/checkpoints/{checkpointId} {
      allow read: if isAuthenticated()
                     && hasProjectRoleById(projectId, ["owner", "admin", "editor", "viewer"]);

      allow create, update: if isAuthenticated()
                               && hasProjectRoleById(projectId, ["owner", "admin", "editor"]);

      allow delete: if isAuthenticated()
                      && hasProjectRoleById(projectId, ["owner", "admin", "editor"]);
    }

    // Comments under items
    match /projects/{projectId}/items/{itemId}/comments/{commentId} {
      allow read: if isAuthenticated()
                     && hasProjectRoleById(projectId, ["owner", "admin", "editor", "viewer"]);

      allow create: if isAuthenticated()
                     && hasProjectRoleById(projectId, ["owner", "admin", "editor"])
                     && request.resource.data.keys().hasAll(["projectId", "itemId", "text"])
                     && request.resource.data.projectId == projectId
                     && request.resource.data.itemId == itemId;

      allow update, delete: if isAuthenticated()
                               && (
                                    resource.data.authorId == getUserId()
                                    || hasProjectRoleById(projectId, ["owner", "admin"])
                                  );
    }

    // Bruger påmindelser / reminders
    match /users/{userId}/reminders/{reminderId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;

      allow create: if isAuthenticated()
                     && request.auth.uid == userId
                     && request.resource.data.keys().hasAll([
                         "targetType", "targetId", "title", "scheduledAt", "repeat"
                       ])
                     && request.resource.data.userId == userId
                     && request.resource.data.targetType in ["item", "checklistItem"]
                     && request.resource.data.scheduledAt is number
                     && request.resource.data.repeat in ["once", "daily", "weekly"];

      allow update: if isAuthenticated() && request.auth.uid == userId;

      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Project-scoped checklists
    match /projects/{projectId}/checklists/{checklistId} {
      allow read: if isAuthenticated()
                     && hasProjectRoleById(projectId, ["owner", "admin", "editor", "viewer"]);

      allow create, update: if isAuthenticated()
                               && hasProjectRoleById(projectId, ["owner", "admin", "editor"]);

      allow delete: if isAuthenticated()
                      && hasProjectRoleById(projectId, ["owner", "admin"]);
    }

    match /projects/{projectId}/checklists/{checklistId}/items/{itemId} {
      allow read: if isAuthenticated()
                     && hasProjectRoleById(projectId, ["owner", "admin", "editor", "viewer"]);

      allow create, update, delete: if isAuthenticated()
                                       && hasProjectRoleById(projectId, ["owner", "admin", "editor"]);
    }

    // Personal/shared checklists (projectId == null)
    match /checklists/{checklistId} {
      function canReadPersonalChecklist() {
        return isAuthenticated()
               && (
                    resource.data.ownerId == getUserId()
                    || getUserId() in resource.data.sharedWith
                  );
      }

      function canWritePersonalChecklist() {
        return isAuthenticated()
               && (
                    resource.data.ownerId == getUserId()
                    || getUserId() in resource.data.sharedWith
                  );
      }

      allow get, list: if canReadPersonalChecklist();

      allow create: if isAuthenticated()
                     && request.resource.data.keys().hasAll(["name", "ownerId"])
                     && request.resource.data.ownerId == getUserId()
                     && request.resource.data.projectId == null;

      allow update: if canWritePersonalChecklist();

      allow delete: if resource.data.ownerId == getUserId();
    }

    match /checklists/{checklistId}/items/{itemId} {
      function parentPersonalChecklistData() {
        return get(/databases/$(database)/documents/checklists/$(checklistId)).data;
      }

      allow read: if isAuthenticated()
                     && (parentPersonalChecklistData().ownerId == getUserId()
                         || getUserId() in parentPersonalChecklistData().sharedWith);

      allow create, update, delete: if isAuthenticated()
                                       && (parentPersonalChecklistData().ownerId == getUserId()
                                           || getUserId() in parentPersonalChecklistData().sharedWith);
    }
  }
}
