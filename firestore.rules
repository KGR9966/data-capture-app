rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hjælpefunktioner
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getProject(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function getProjectData(projectId) {
      return getProject(projectId).data;
    }

    function isProjectMember(projectId) {
      return isAuthenticated()
             && (getProjectData(projectId).ownerId == getUserId()
                 || getUserId() in getProjectData(projectId).roles
                 || (request.auth.token.email != null
                     && request.auth.token.email in getProjectData(projectId).memberEmails));
    }

    function hasProjectRole(projectId, allowedRoles) {
      return isAuthenticated()
             && (getProjectData(projectId).ownerId == getUserId()
                 || (getUserId() in getProjectData(projectId).roles
                     && getProjectData(projectId).roles.get(getUserId(), null) in allowedRoles));
    }

    function canCreateInProject(projectId) {
      return hasProjectRole(projectId, ["owner", "admin", "editor"]);
    }

    // Projekter
    match /projects/{projectId} {
      function projectData() {
        return resource.data;
      }

      function isProjectReader() {
        return isAuthenticated()
               && (projectData().ownerId == getUserId()
                   || getUserId() in projectData().roles
                   || (request.auth.token.email != null
                       && request.auth.token.email in projectData().memberEmails));
      }

      allow read: if isProjectReader();

      allow create: if isAuthenticated() && request.resource.data.ownerId == getUserId();

      allow update: if isAuthenticated()
                     && (resource.data.ownerId == getUserId()
                         || (getUserId() in resource.data.roles
                             && request.resource.data.roles.get(getUserId(), null) in ["owner", "admin"]));

      allow delete: if isAuthenticated() && resource.data.ownerId == getUserId();
    }

    // Projekt-medlemmer
    match /projects/{projectId}/members/{memberId} {
      // Ved læsning bruges get() på det eksisterende projekt.
      // Ved create/update/delete bruges getAfter(), så reglerne virker i
      // batched writes hvor projektet oprettes samtidig med medlemsdokumentet.
      function projectDataForRead() {
        return get(/databases/$(database)/documents/projects/$(projectId)).data;
      }

      function projectDataForWrite() {
        return getAfter(/databases/$(database)/documents/projects/$(projectId)).data;
      }

      function isProjectReader() {
        return isAuthenticated()
               && (projectDataForRead().ownerId == getUserId()
                   || getUserId() in projectDataForRead().roles
                   || (request.auth.token.email != null
                       && request.auth.token.email in projectDataForRead().memberEmails));
      }

      function isProjectOwnerOrAdmin() {
        return isAuthenticated()
               && (projectDataForWrite().ownerId == getUserId()
                   || (getUserId() in projectDataForWrite().roles
                       && projectDataForWrite().roles.get(getUserId(), null) in ["owner", "admin"]));
      }

      allow read: if isProjectReader();

      allow create: if isProjectOwnerOrAdmin()
                     && request.resource.data.keys().hasAll(["role"])
                     && request.resource.data.role in ["owner", "admin", "editor", "viewer"];

      allow update: if isProjectOwnerOrAdmin()
                     && request.resource.data.keys().hasAll(["role"])
                     && request.resource.data.role in ["owner", "admin", "editor", "viewer"];

      allow delete: if isProjectOwnerOrAdmin();
    }

    // Sager / items
    match /items/{itemId} {
      function itemProjectId() {
        return resource.data.projectId;
      }

      function canReadItem() {
        return isAuthenticated()
               && exists(/databases/$(database)/documents/projects/$(itemProjectId()))
               && (getProjectData(itemProjectId()).ownerId == getUserId()
                   || getUserId() in getProjectData(itemProjectId()).roles
                   || (request.auth.token.email != null
                       && request.auth.token.email in getProjectData(itemProjectId()).memberEmails));
      }

      function canUpdateItem() {
        return isAuthenticated()
               && exists(/databases/$(database)/documents/projects/$(itemProjectId()))
               && (getProjectData(itemProjectId()).ownerId == getUserId()
                   || (getUserId() in getProjectData(itemProjectId()).roles
                       && ["owner", "admin", "editor"].hasAny([getProjectData(itemProjectId()).roles.get(getUserId(), null)]))
                   || (resource.data.assignedTo == getUserId()
                       && getUserId() in getProjectData(itemProjectId()).roles
                       && getProjectData(itemProjectId()).roles.get(getUserId(), null) == "editor"));
      }

      allow read: if canReadItem();

      allow create: if isAuthenticated()
                     && request.resource.data.keys().hasAll(["projectId", "createdBy"])
                     && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
                     && canCreateInProject(request.resource.data.projectId);

      allow update: if canUpdateItem();

      allow delete: if isAuthenticated()
                     && exists(/databases/$(database)/documents/projects/$(itemProjectId()))
                     && (getProjectData(itemProjectId()).ownerId == getUserId()
                         || (getUserId() in getProjectData(itemProjectId()).roles
                             && ["owner", "admin"].hasAny([getProjectData(itemProjectId()).roles.get(getUserId(), null)])));
    }

    // Checkpoints under items
    match /items/{itemId}/checkpoints/{checkpointId} {
      function parentItem() {
        return get(/databases/$(database)/documents/items/$(itemId));
      }

      function canReadParentItem() {
        return isAuthenticated()
               && parentItem().data != null
               && exists(/databases/$(database)/documents/projects/$(parentItem().data.projectId))
               && (getProjectData(parentItem().data.projectId).ownerId == getUserId()
                   || getUserId() in getProjectData(parentItem().data.projectId).roles
                   || (request.auth.token.email != null
                       && request.auth.token.email in getProjectData(parentItem().data.projectId).memberEmails));
      }

      function canUpdateParentItem() {
        return isAuthenticated()
               && parentItem().data != null
               && exists(/databases/$(database)/documents/projects/$(parentItem().data.projectId))
               && (getProjectData(parentItem().data.projectId).ownerId == getUserId()
                   || (getUserId() in getProjectData(parentItem().data.projectId).roles
                       && ["owner", "admin", "editor"].hasAny([getProjectData(parentItem().data.projectId).roles.get(getUserId(), null)]))
                   || (parentItem().data.assignedTo == getUserId()
                       && getUserId() in getProjectData(parentItem().data.projectId).roles
                       && getProjectData(parentItem().data.projectId).roles.get(getUserId(), null) == "editor"));
      }

      allow read: if canReadParentItem();

      allow create: if canUpdateParentItem()
                     && request.resource.data.keys().hasAll(["itemId", "projectId", "sourceField", "text", "status"])
                     && request.resource.data.itemId == itemId;

      allow update: if canUpdateParentItem();

      allow delete: if canUpdateParentItem();
    }

    // Kommentarer
    match /items/{itemId}/comments/{commentId} {
      allow read: if isAuthenticated()
                   && exists(/databases/$(database)/documents/items/$(itemId))
                   && exists(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/items/$(itemId)).data.projectId))
                   && (get(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/items/$(itemId)).data.projectId)).data.ownerId == getUserId()
                       || getUserId() in get(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/items/$(itemId)).data.projectId)).data.members
                       || getUserId() in get(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/items/$(itemId)).data.projectId)).data.roles);

      allow create: if isAuthenticated()
                     && request.resource.data.keys().hasAll(["projectId", "itemId", "text"])
                     && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
                     && (get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.ownerId == getUserId()
                         || (getUserId() in get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.roles
                             && ["owner", "admin", "editor"].hasAny([get(/databases/$(database)/documents/projects/$(request.resource.data.projectId)).data.roles.get(getUserId(), null)])));

      allow update, delete: if isAuthenticated()
                             && exists(/databases/$(database)/documents/items/$(itemId))
                             && (resource.data.authorId == getUserId()
                                 || (get(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/items/$(itemId)).data.projectId)).data.ownerId == getUserId())
                                 || (getUserId() in get(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/items/$(itemId)).data.projectId)).data.roles
                                     && ["owner", "admin"].hasAny([get(/databases/$(database)/documents/projects/$(get(/databases/$(database)/documents/items/$(itemId)).data.projectId)).data.roles.get(getUserId(), null)])));
    }

    // Aktionslister / checklists
    match /checklists/{checklistId} {
      function checklistData() {
        return resource.data;
      }

      function canReadChecklist() {
        return isAuthenticated()
               && (checklistData().ownerId == getUserId()
                   || getUserId() in checklistData().sharedWith
                   || (checklistData().projectId != null
                       && isProjectMember(checklistData().projectId)));
      }

      function canUpdateChecklist() {
        return isAuthenticated()
               && (checklistData().ownerId == getUserId()
                   || (getUserId() in checklistData().sharedWith
                       && checklistData().sharedWith.get(getUserId(), null) in ["owner", "admin", "editor"])
                   || (checklistData().projectId != null
                       && hasProjectRole(checklistData().projectId, ["owner", "admin"])));
      }

      function canDeleteChecklist() {
        return isAuthenticated()
               && (checklistData().ownerId == getUserId()
                   || (checklistData().projectId != null
                       && hasProjectRole(checklistData().projectId, ["owner", "admin"])));
      }

      allow read: if canReadChecklist();

      allow create: if isAuthenticated()
                     && request.resource.data.keys().hasAll(["name", "ownerId"])
                     && request.resource.data.ownerId == getUserId()
                     && (
                          !request.resource.data.keys().hasAny(["projectId"])
                          || request.resource.data.projectId == null
                          || canCreateInProject(request.resource.data.projectId)
                        );

      allow update: if canUpdateChecklist();

      allow delete: if canDeleteChecklist();
    }

    match /checklists/{checklistId}/items/{itemId} {
      function parentChecklist() {
        return get(/databases/$(database)/documents/checklists/$(checklistId));
      }

      function canReadChecklistPoint() {
        return isAuthenticated()
               && exists(/databases/$(database)/documents/checklists/$(checklistId))
               && (parentChecklist().data.ownerId == getUserId()
                   || getUserId() in parentChecklist().data.sharedWith
                   || (parentChecklist().data.projectId != null
                       && isProjectMember(parentChecklist().data.projectId)));
      }

      function canUpdateChecklistPoint() {
        return isAuthenticated()
               && exists(/databases/$(database)/documents/checklists/$(checklistId))
               && (parentChecklist().data.ownerId == getUserId()
                   || (getUserId() in parentChecklist().data.sharedWith
                       && parentChecklist().data.sharedWith.get(getUserId(), null) in ["owner", "admin", "editor"])
                   || (parentChecklist().data.projectId != null
                       && hasProjectRole(parentChecklist().data.projectId, ["owner", "admin", "editor"])));
      }

      allow read: if canReadChecklistPoint();

      allow create: if canUpdateChecklistPoint();

      allow update, delete: if canUpdateChecklistPoint();
    }
  }
}
