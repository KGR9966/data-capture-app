rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hjælpefunktioner
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserId() {
      return request.auth.uid;
    }

    function getUserEmail() {
      return request.auth.token.email;
    }

    // Aflæs brugerens rolle i et projekt ud fra ownerId, roles-kort og memberEmails.
    // Email-inviterede medlemmer uden specifik rolle får editor-rettigheder.
    function getProjectMemberRole(projectData) {
      return isAuthenticated()
             ? (getUserId() == projectData.ownerId
                ? "owner"
                : (getUserId() in projectData.roles
                   ? projectData.roles.get(getUserId(), null)
                   : (getUserEmail() != null
                      && getUserEmail() in projectData.memberEmails
                      ? "editor"
                      : null)))
             : null;
    }

    function hasAnyProjectRole(projectData, allowedRoles) {
      return getProjectMemberRole(projectData) in allowedRoles;
    }

    function projectDataById(projectId) {
      return projectId != null && exists(/databases/$(database)/documents/projects/$(projectId))
             ? get(/databases/$(database)/documents/projects/$(projectId)).data
             : null;
    }

    function hasProjectRoleById(projectId, allowedRoles) {
      return getProjectMemberRole(projectDataById(projectId)) in allowedRoles;
    }

    // Projekter
    match /projects/{projectId} {
      function projectData() {
        return resource.data;
      }

      allow read: if isAuthenticated()
                     && hasAnyProjectRole(projectData(), ["owner", "admin", "editor", "viewer"]);

      allow create: if isAuthenticated() && request.resource.data.ownerId == getUserId();

      allow update: if isAuthenticated()
                     && (resource.data.ownerId == getUserId()
                         || (getUserId() in resource.data.roles
                             && request.resource.data.roles.get(getUserId(), null) in ["owner", "admin"]));

      allow delete: if isAuthenticated() && resource.data.ownerId == getUserId();
    }

    // Projekt-medlemmer
    match /projects/{projectId}/members/{memberId} {
      // Bemærk: Brug getAfter() i stedet for get() her, fordi medlemsdokumentet
      // ofte oprettes i samme batched write som projekt-dokumentet. getAfter()
      // ser projektets tilstand efter batchen er anvendt, mens get() ser den
      // nuværende tilstand før batchen.
      function projectData() {
        return getAfter(/databases/$(database)/documents/projects/$(projectId)).data;
      }

      function isProjectOwnerOrAdmin() {
        return isAuthenticated()
               && (projectData().ownerId == getUserId()
                   || (getUserId() in projectData().roles
                       && projectData().roles.get(getUserId(), null) in ["owner", "admin"]));
      }

      allow read: if isAuthenticated()
                     && hasAnyProjectRole(projectData(), ["owner", "admin", "editor", "viewer"]);

      allow create: if isProjectOwnerOrAdmin()
                     && request.resource.data.keys().hasAll(["role"])
                     && request.resource.data.role in ["owner", "admin", "editor", "viewer"];

      allow update: if isProjectOwnerOrAdmin()
                     && request.resource.data.keys().hasAll(["role"])
                     && request.resource.data.role in ["owner", "admin", "editor", "viewer"];

      allow delete: if isProjectOwnerOrAdmin();
    }

    // Sager / items
    match /items/{itemId} {
      function project() {
        return get(/databases/$(database)/documents/projects/$(resource.data.projectId));
      }

      function projectData() {
        return project().data;
      }

      allow read: if isAuthenticated()
                     && exists(project().path)
                     && hasAnyProjectRole(projectData(), ["owner", "admin", "editor", "viewer"]);

      allow create: if isAuthenticated()
                     && request.resource.data.keys().hasAll(["projectId", "createdBy"])
                     && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
                     && hasProjectRoleById(request.resource.data.projectId, ["owner", "admin", "editor"]);

      allow update: if isAuthenticated()
                     && exists(project().path)
                     && (hasAnyProjectRole(projectData(), ["owner", "admin"])
                         || (hasAnyProjectRole(projectData(), ["editor"])
                             && (resource.data.createdBy == getUserId()
                                 || resource.data.assignedTo == getUserId())));

      allow delete: if isAuthenticated()
                     && exists(project().path)
                     && (hasAnyProjectRole(projectData(), ["owner", "admin"])
                         || (hasAnyProjectRole(projectData(), ["editor"])
                             && resource.data.createdBy == getUserId()));
    }

    // Checkpoints under items (afkrydsningspunkter)
    match /items/{itemId}/checkpoints/{checkpointId} {
      function checkpointProject() {
        return get(/databases/$(database)/documents/projects/$(resource.data.projectId));
      }

      function checkpointProjectData() {
        return checkpointProject().data;
      }

      allow read: if isAuthenticated()
                     && exists(checkpointProject().path)
                     && hasAnyProjectRole(checkpointProjectData(), ["owner", "admin", "editor", "viewer"]);

      allow create, update: if isAuthenticated()
                               && exists(checkpointProject().path)
                               && hasAnyProjectRole(checkpointProjectData(), ["owner", "admin", "editor"]);

      allow delete: if isAuthenticated()
                       && exists(checkpointProject().path)
                       && hasAnyProjectRole(checkpointProjectData(), ["owner", "admin", "editor"]);
    }

    // Kommentarer
    match /items/{itemId}/comments/{commentId} {
      function parentItem() {
        return get(/databases/$(database)/documents/items/$(itemId));
      }

      function parentItemProject() {
        return get(/databases/$(database)/documents/projects/$(parentItem().data.projectId));
      }

      function parentItemProjectData() {
        return parentItemProject().data;
      }

      allow read: if isAuthenticated()
                     && exists(parentItem().path)
                     && exists(parentItemProject().path)
                     && hasAnyProjectRole(parentItemProjectData(), ["owner", "admin", "editor", "viewer"]);

      allow create: if isAuthenticated()
                     && request.resource.data.keys().hasAll(["projectId", "itemId", "text"])
                     && exists(/databases/$(database)/documents/projects/$(request.resource.data.projectId))
                     && hasProjectRoleById(request.resource.data.projectId, ["owner", "admin", "editor"]);

      allow update, delete: if isAuthenticated()
                               && exists(parentItem().path)
                               && exists(parentItemProject().path)
                               && (resource.data.authorId == getUserId()
                                   || hasAnyProjectRole(parentItemProjectData(), ["owner", "admin"]));
    }

    // Bruger påmindelser / reminders
    match /users/{userId}/reminders/{reminderId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;

      allow create: if isAuthenticated()
                     && request.auth.uid == userId
                     && request.resource.data.keys().hasAll([
                         "targetType", "targetId", "title", "scheduledAt", "repeat"
                       ])
                     && request.resource.data.userId == userId
                     && request.resource.data.targetType in ["item", "checklistItem"]
                     && request.resource.data.scheduledAt is number
                     && request.resource.data.repeat in ["once", "daily", "weekly"];

      allow update: if isAuthenticated() && request.auth.uid == userId;

      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Aktionslister / checklists
    match /checklists/{checklistId} {
      function canReadChecklist() {
        return isAuthenticated()
               && (resource.data.ownerId == getUserId()
                   || getUserId() in resource.data.sharedWith
                   || (resource.data.projectId != null
                       && hasProjectRoleById(resource.data.projectId, ["owner", "admin", "editor", "viewer"])));
      }

      function canWriteChecklist() {
        return isAuthenticated()
               && (resource.data.ownerId == getUserId()
                   || (getUserId() in resource.data.sharedWith
                       && resource.data.sharedWith.get(getUserId(), null) in ["owner", "admin", "editor"])
                   || (resource.data.projectId != null
                       && hasProjectRoleById(resource.data.projectId, ["owner", "admin", "editor"])));
      }

      function canDeleteChecklist() {
        return isAuthenticated()
               && (resource.data.ownerId == getUserId()
                   || (resource.data.projectId != null
                       && hasProjectRoleById(resource.data.projectId, ["owner", "admin"])));
      }

      allow read: if canReadChecklist();

      allow create: if isAuthenticated()
                     && request.resource.data.keys().hasAll(["name", "ownerId"])
                     && request.resource.data.ownerId == getUserId()
                     && (request.resource.data.projectId == null
                         || hasProjectRoleById(request.resource.data.projectId, ["owner", "admin", "editor"]));

      allow update: if canWriteChecklist();

      allow delete: if canDeleteChecklist();
    }

    match /checklists/{checklistId}/items/{itemId} {
      function parentChecklist() {
        return get(/databases/$(database)/documents/checklists/$(checklistId));
      }

      function parentChecklistData() {
        return parentChecklist().data;
      }

      function canReadChecklistItem() {
        return isAuthenticated()
               && exists(parentChecklist().path)
               && (parentChecklistData().ownerId == getUserId()
                   || getUserId() in parentChecklistData().sharedWith
                   || (parentChecklistData().projectId != null
                       && hasProjectRoleById(parentChecklistData().projectId, ["owner", "admin", "editor", "viewer"])));
      }

      function canWriteChecklistItem() {
        return isAuthenticated()
               && exists(parentChecklist().path)
               && (parentChecklistData().ownerId == getUserId()
                   || (getUserId() in parentChecklistData().sharedWith
                       && parentChecklistData().sharedWith.get(getUserId(), null) in ["owner", "admin", "editor"])
                   || (parentChecklistData().projectId != null
                       && hasProjectRoleById(parentChecklistData().projectId, ["owner", "admin", "editor"])));
      }

      allow read: if canReadChecklistItem();

      allow create, update, delete: if canWriteChecklistItem();
    }
  }
}
