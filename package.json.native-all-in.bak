{
  "name": "data-capture-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:safe": "node scripts/start-safe.js",
    "start:lan": "expo start --dev-client --lan -c",
    "start:tunnel": "expo start --dev-client --tunnel -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "tsc": "tsc --noEmit",
    "pre-test-check": "node scripts/pre-test-check.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@gabriel-sisjr/react-native-background-location": "^1.0.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/storage": "^25.1.0",
    "expo": "~57.0.4",
    "expo-clipboard": "~57.0.0",
    "expo-constants": "^57.0.3",
    "expo-dev-client": "^57.0.5",
    "expo-file-system": "~57.0.0",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~57.0.2",
    "expo-linking": "~57.0.2",
    "expo-mlkit-ocr": "^0.2.7",
    "expo-notifications": "^57.0.3",
    "expo-router": "^57.0.4",
    "expo-speech-recognition": "^56.0.1",
    "expo-splash-screen": "^57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "^57.0.0",
    "firebase": "^12.16.0",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.0",
    "react-native-background-geolocation": "^5.3.0",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
