# Firebase configuration for Data Capture app
# Replace with values from your Firebase project settings

EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Cloud Translation API key (required for OCR translation in the app).
# Create one in Google Cloud Console: APIs & Services > Credentials > API key.
# Enable the Cloud Translation API for your project.
EXPO_PUBLIC_GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Optional: seed script test user mapping for E2E preview builds.
# The seed script creates test data where ownerId/memberEmails match these values.
# For EAS preview builds, set SEED_OWNER_UID to the Firebase Auth UID of the test user
# that will sign in on the device, and SEED_MEMBER_EMAIL to that user's email.
SEED_OWNER_UID=user_owner
SEED_MEMBER_UID=email_user
SEED_MEMBER_EMAIL=email_editor@example.com
SEED_ADMIN_UID=user_admin
SEED_EDITOR_UID=user_editor
SEED_VIEWER_UID=user_viewer
SEED_NON_MEMBER_UID=user_non_member
