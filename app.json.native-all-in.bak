{
  "expo": {
    "name": "Data Capture",
    "slug": "data-capture-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "datacapture",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kgradm.datacapture",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Data Capture bruger mikrofonen til at konvertere din stemme til tekst.",
        "NSSpeechRecognitionUsageDescription": "Data Capture bruger talegenkendelse til at omforme dine observationer og noter til tekst.",
        "NSCameraUsageDescription": "Data Capture bruger kameraet til at tage billeder til sager.",
        "NSPhotoLibraryUsageDescription": "Data Capture bruger fotoalbummet til at vedhæfte billeder til sager.",
        "NSLocationWhenInUseUsageDescription": "Data Capture bruger din position til at påminde dig om sager nær bestemte steder.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Data Capture skal bruge adgang til position i baggrunden for at kunne give geofence-påmindelser.",
        "NSLocationAlwaysUsageDescription": "Data Capture bruger din position i baggrunden til geofence-påmindelser.",
        "UIBackgroundModes": ["location", "fetch", "remote-notification"]
      }
    },
    "android": {
      "package": "com.kgradm.datacapture",
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a",
          "dark": {
            "backgroundColor": "#0f172a"
          }
        }
      ],
      "expo-notifications",
      "expo-font",
      "@react-native-firebase/app",
      "expo-mlkit-ocr",
      "react-native-background-geolocation"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05d8b831-18ca-4f4c-9bdc-9fdd62e3705b"
      }
    },
    "owner": "kgradm"
  }
}
